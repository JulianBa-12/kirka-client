# Copy to .env (never commit .env). All secrets stay on the server.
POLARIS_PORT=8787
POLARIS_HOST=127.0.0.1
# Public base URL used to build absolute file URLs (no trailing slash)
POLARIS_PUBLIC_URL=http://127.0.0.1:8787
# Data directory (database, uploads, keys, backups, logs)
POLARIS_DATA_DIR=./data
# Comma-separated browser origins allowed to call the API (the Community Hub)
POLARIS_CORS_ORIGINS=https://julianba-12.github.io,http://localhost:5173,http://127.0.0.1:5173
# Set to 1 behind a reverse proxy (X-Forwarded-For)
POLARIS_TRUST_PROXY=0
# Optional: path to an existing Ed25519 private key (PEM). Generated in DATA_DIR/keys if absent.
POLARIS_SIGNING_KEY_FILE=
# Optional: GitHub Pages publishing (token needs contents:write on the repo)
POLARIS_GITHUB_TOKEN=
POLARIS_GITHUB_REPO=JulianBa-12/kirka-client
POLARIS_GITHUB_BRANCH=main
POLARIS_GITHUB_PATH=apps/community-hub/public/data
